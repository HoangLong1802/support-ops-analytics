// Add each definition as a measure. Format ratios as percentages.
// Return zero for empty ticket cohorts; calendar-day denominators remain selected coverage.
Total Tickets = COALESCE ( COUNTROWS ( fact_tickets ), 0 )
Completed Tickets = CALCULATE ( [Total Tickets], fact_tickets[completed] = TRUE () )
Open Tickets = CALCULATE ( [Total Tickets], fact_tickets[status] = "open" )
Pending Tickets = CALCULATE ( [Total Tickets], fact_tickets[status] = "pending" )

FR SLA Met = CALCULATE ( [Total Tickets], fact_tickets[fr_sla_outcome] = "MET" )
FR SLA Breached = CALCULATE ( [Total Tickets], fact_tickets[fr_sla_outcome] = "BREACHED" )
FR SLA Pending = CALCULATE ( [Total Tickets], fact_tickets[fr_sla_outcome] = "PENDING" )
FR SLA Compliance % = DIVIDE ( [FR SLA Met], [FR SLA Met] + [FR SLA Breached] )
FR SLA Breach % = DIVIDE ( [FR SLA Breached], [FR SLA Met] + [FR SLA Breached] )
Resolution SLA Met = CALCULATE ( [Total Tickets], fact_tickets[resolution_sla_outcome] = "MET" )
Resolution SLA Breached = CALCULATE ( [Total Tickets], fact_tickets[resolution_sla_outcome] = "BREACHED" )
Resolution SLA Pending = CALCULATE ( [Total Tickets], fact_tickets[resolution_sla_outcome] = "PENDING" )
Resolution SLA Compliance % = DIVIDE ( [Resolution SLA Met], [Resolution SLA Met] + [Resolution SLA Breached] )
Resolution SLA Breach % = DIVIDE ( [Resolution SLA Breached], [Resolution SLA Met] + [Resolution SLA Breached] )
Overall SLA Met = CALCULATE ( [Total Tickets], fact_tickets[overall_sla_outcome] = "MET" )
Overall SLA Breached = CALCULATE ( [Total Tickets], fact_tickets[overall_sla_outcome] = "BREACHED" )
Overall SLA Pending = CALCULATE ( [Total Tickets], fact_tickets[overall_sla_outcome] = "PENDING" )
Overall SLA Compliance % = DIVIDE ( [Overall SLA Met], [Overall SLA Met] + [Overall SLA Breached] )
Overall SLA Breach % = DIVIDE ( [Overall SLA Breached], [Overall SLA Met] + [Overall SLA Breached] )

Average First Response Minutes = AVERAGE ( fact_tickets[first_response_minutes] )
Average Resolution Hours = DIVIDE ( AVERAGE ( fact_tickets[resolution_minutes] ), 60 )
Median Resolution Hours = DIVIDE ( MEDIAN ( fact_tickets[resolution_minutes] ), 60 )
P95 Resolution Hours =
VAR CompletedDurations =
    FILTER ( fact_tickets, NOT ISBLANK ( fact_tickets[resolution_minutes] ) )
RETURN
    IF (
        COUNTROWS ( CompletedDurations ) > 0,
        DIVIDE ( PERCENTILEX.INC ( CompletedDurations, fact_tickets[resolution_minutes], 0.95 ), 60 )
    )
Average CSAT = AVERAGE ( fact_tickets[csat_score] )
CSAT Responses = CALCULATE ( [Total Tickets], fact_tickets[completed] = TRUE (), NOT ISBLANK ( fact_tickets[csat_score] ) )
CSAT Response Rate % = DIVIDE ( [CSAT Responses], [Completed Tickets] )
Reopened Tickets = CALCULATE ( [Total Tickets], fact_tickets[reopen_count] > 0 )
Reopen Rate % = DIVIDE ( [Reopened Tickets], [Total Tickets] )

Backlog = [Open Tickets] + [Pending Tickets]
Backlog % = DIVIDE ( [Backlog], [Total Tickets] )
Backlog >24 Hours = CALCULATE ( [Total Tickets], fact_tickets[completed] = FALSE (), fact_tickets[backlog_age_minutes] > 1440 )
Backlog >48 Hours = CALCULATE ( [Total Tickets], fact_tickets[completed] = FALSE (), fact_tickets[backlog_age_minutes] > 2880 )
Backlog >72 Hours = CALCULATE ( [Total Tickets], fact_tickets[completed] = FALSE (), fact_tickets[backlog_age_minutes] > 4320 )

Handling Hours = DIVIDE ( SUM ( fact_work_logs[handling_minutes] ), 60 )
Scheduled Hours = DIVIDE ( SUM ( fact_workforce_daily[scheduled_minutes] ), 60 )
Absence Hours = DIVIDE ( SUM ( fact_workforce_daily[absence_minutes] ), 60 )
Shrinkage Hours = DIVIDE ( SUM ( fact_workforce_daily[shrinkage_minutes] ), 60 )
Productive Capacity Hours = [Scheduled Hours] - [Absence Hours] - [Shrinkage Hours]
Utilization % = DIVIDE ( [Handling Hours], [Productive Capacity Hours] )

Calendar Days = COUNTROWS ( dim_date )
Average Daily Tickets = DIVIDE ( [Total Tickets], [Calendar Days] )
// Contribution shares retain date/channel/priority scope while comparing all categories.
Ticket Share % =
DIVIDE ( [Total Tickets], CALCULATE ( [Total Tickets], REMOVEFILTERS ( dim_categories ) ) )
Resolution Breach Share % =
DIVIDE (
    [Resolution SLA Breached],
    CALCULATE ( [Resolution SLA Breached], REMOVEFILTERS ( dim_categories ) )
)

Tickets Previous Month = CALCULATE ( [Total Tickets], DATEADD ( dim_date[date_key], -1, MONTH ) )
MoM Ticket Change % = DIVIDE ( [Total Tickets] - [Tickets Previous Month], [Tickets Previous Month] )
7 Day Average Tickets =
VAR EndDate = MAX ( dim_date[date_key] )
VAR WindowDates =
    FILTER ( ALL ( dim_date ), dim_date[date_key] <= EndDate && dim_date[date_key] > EndDate - 7 )
RETURN
    AVERAGEX (
        WindowDates,
        VAR ThisDate = dim_date[date_key]
        RETURN COALESCE (
            CALCULATE ( [Total Tickets], REMOVEFILTERS ( dim_date ), dim_date[date_key] = ThisDate ),
            0
        )
    )

// Optional category/channel cohort handling. Capacity is still total agent/day capacity.
Selected Ticket Handling Hours =
VAR TicketsInCohort = VALUES ( fact_tickets[ticket_id] )
RETURN CALCULATE ( [Handling Hours], TREATAS ( TicketsInCohort, fact_work_logs[ticket_id] ) )


// Day-type denominators retain selected date coverage, including zero-ticket days.
Weekday Tickets = CALCULATE ( [Total Tickets], KEEPFILTERS ( dim_date[is_weekend] = FALSE () ) )
Weekend Tickets = CALCULATE ( [Total Tickets], KEEPFILTERS ( dim_date[is_weekend] = TRUE () ) )
Weekday Calendar Days = CALCULATE ( [Calendar Days], KEEPFILTERS ( dim_date[is_weekend] = FALSE () ) )
Weekend Calendar Days = CALCULATE ( [Calendar Days], KEEPFILTERS ( dim_date[is_weekend] = TRUE () ) )
Weekday Average Daily Tickets = DIVIDE ( [Weekday Tickets], [Weekday Calendar Days] )
Weekend Average Daily Tickets = DIVIDE ( [Weekend Tickets], [Weekend Calendar Days] )
Weekday Weekend Average Ratio = DIVIDE ( [Weekday Average Daily Tickets], [Weekend Average Daily Tickets] )
Weekday Weekend Total Ratio = DIVIDE ( [Weekday Tickets], [Weekend Tickets] )

// Measures added after the first version (also in the PBIX).

// Distinct agents owning at least one ticket in the current filter context (assigned_agent_id not blank).
Active Agents = DISTINCTCOUNT ( fact_tickets[assigned_agent_id] )

// Assigned tickets / distinct owning agents. Weighted ratio, never an average of per-agent ratios. Unassigned tickets excluded from numerator.
Tickets per Agent = DIVIDE ( CALCULATE ( [Total Tickets], NOT ISBLANK ( fact_tickets[assigned_agent_id] ) ), [Active Agents] )

// Completed tickets with a CSAT score of 1 or 2.
Low CSAT Responses = CALCULATE ( [Total Tickets], fact_tickets[completed] = TRUE (), fact_tickets[csat_score] >= 1, fact_tickets[csat_score] <= 2 )

// Low CSAT responses / all CSAT responses. Blank scores excluded from the denominator.
Low CSAT Rate % = DIVIDE ( [Low CSAT Responses], [CSAT Responses] )

// Mean age in hours at the 01/10/2026 00:00 UTC+7 snapshot of tickets not completed.
Average Backlog Age Hours = DIVIDE ( AVERAGEX ( FILTER ( fact_tickets, fact_tickets[completed] = FALSE () ), fact_tickets[backlog_age_minutes] ), 60 )

// Median age in hours at the snapshot of tickets not completed.
Median Backlog Age Hours = DIVIDE ( MEDIANX ( FILTER ( fact_tickets, fact_tickets[completed] = FALSE () ), fact_tickets[backlog_age_minutes] ), 60 )

// Tickets created in the 30 calendar days ending on the last visible date / 30.
Rolling 30D Avg Daily Tickets = DIVIDE ( CALCULATE ( [Total Tickets], DATESINPERIOD ( dim_date[date_key], MAX ( dim_date[date_key] ), -30, DAY ) ), 30 )

// Resolution SLA Compliance % for the prior calendar month of the visible period.
Resolution SLA Compliance % Previous Month = CALCULATE ( [Resolution SLA Compliance %], DATEADD ( dim_date[date_key], -1, MONTH ) )

// Resolution SLA Compliance % minus previous month, in percentage points. Blank when no prior month exists.
Resolution SLA MoM Change pp = VAR prev = [Resolution SLA Compliance % Previous Month] RETURN IF ( ISBLANK ( prev ) || ISBLANK ( [Resolution SLA Compliance %] ), BLANK (), ( [Resolution SLA Compliance %] - prev ) * 100 )

// Handling hours / distinct agents with a work log in context.
Handling Hours per Agent = DIVIDE ( [Handling Hours], DISTINCTCOUNT ( fact_work_logs[agent_id] ) )

// Handling minutes / distinct tickets worked. A ticket can have several work logs.
Handling Minutes per Ticket = DIVIDE ( [Handling Hours] * 60, DISTINCTCOUNT ( fact_work_logs[ticket_id] ) )

// Absence hours / scheduled hours.
Absence Rate % = DIVIDE ( [Absence Hours], [Scheduled Hours] )

// Shrinkage hours / scheduled hours.
Shrinkage Rate % = DIVIDE ( [Shrinkage Hours], [Scheduled Hours] )

